      "isAspect": true,
      "isHidden": true
    },
    {
      "id": "mission.tomoriserpent.a",
      "label": "意图：落泪的少女",
      "description": "过去很长一段时间我都不解那一种悲伤，直到我发现她已鲜少悲伤。我将不解的目标改为她本身，而在她的目光中，我又将问题抛向了自己。",
      "xtriggers": {
          "opx.progress0": [
        {
            "id": "challenge.contemplation.tomoriserpent.a",
            "morpheffect": "spawn"
        }
          ],
          "ascend": "mission.tomoriserpent.b"
      },
      "aspects": {
          "contemplation": 1
      },
      "uniquenessgroup": "missiontomoriserpent"
    },
    {
      "id": "challenge.contemplation.tomoriserpent.a",
      "label": "Serpent Challenge A",
      "aspects": {
          "needsknock": 8,
          "needsmoth": 8
      },
      "isHidden": true,
      "lifetime": 1
    },
    {
      "id": "mission.tomoriserpent.b",
      "label": "意图：落泪的士兵",
      "description": "每一个刃之学徒的灵魂里都埋着大片废墟，我是否走的太远，我是否已经忘记了自己的模样，废墟里的我又如何看待这个问题。",
      "xtriggers": {
          "opx.progress0": [
        {
            "id": "challenge.contemplation.tomoriserpent.b",
            "morpheffect": "spawn"
        }
          ],
          "ascend": "mission.tomoriserpent.c"
      },
      "aspects": {
          "contemplation": 1
      },
      "uniquenessgroup": "missiontomoriserpent"
    },
    {
      "id": "challenge.contemplation.tomoriserpent.b",
      "label": "Serpent Challenge B",
      "aspects": {
          "needsknock": 12,
          "needsmoth": 12
      },
      "isHidden": true,
      "lifetime": 1
    },
    {
      "id": "mission.tomoriserpent.c",
      "label": "意图：落泪的利器",
      "description": "蛇比飞鸟更接近根系，比走兽更深入黑暗。我会闭上双眼。\n<i>“不容拒绝的访客会见证我于可见与不可见的规训之下逃脱。”</i>\n然而一切不会真的消失，在我完成应尽的义务之后，我或许可以休眠。\n\n[在命定之地，如果我已完成伟业，我或许能依靠其完成更多功业；如果我未完成伟业，我或许也可以依靠其开启不一样的道路]",
      "aspects": {
          "contemplation": 1,
          "completed": 1,
          "knock": 1,
          "talkwithtomoriserpent": 1
      },
      "uniquenessgroup": "missiontomoriserpent"
    },

    {
      "id": "diary.tomoriserpent",
      "label": "日记",
      "isAspect": true,
      "isHidden": true
    },
    {
      "id": "diary.tomoriserpent.a",
      "label": "日记其一",
      "description": "敌人炮弹的啸声压过风声，我以钢的技艺偏转炮火落点，轰鸣炸响在空地，阵地得于保全，无人在意的土地上平添了丑陋的伤口。一旁的少女静静看着全程，眼中毫无惊惧，反而流露怜悯。她缓步上前，指尖轻轻抚过我脸上的伤疤，然后展示了她的。战争中人人皆有伤痕，而世界亦然。",
      "aspects": {
          "diary.tomoriserpent": 1
      }
    },
    {
      "id": "diary.tomoriserpent.b",
      "label": "日记其二",
      "description": "阵地伤亡惨重，数名士兵倒在冻土之上，躯体尚温、魂息未散。我再度征召起他们，驱动他们的残躯，复活的士兵维持着牺牲时的姿态爬起。哭泣的少女穿梭在尸体之间，为每一名苏醒的战友扶正歪落的军帽，用泥土掩住他们可怖的脸。做完这一切，她发现了我，快步走到我身前，踮起脚尖，认真为我抚平褶皱的军装、理好凌乱的衣领。即便我还没有死去。即便我现在还没有死去。",
      "aspects": {
          "diary.tomoriserpent": 1
      },
      "icon": "documentgeneric"
    },
    {
      "id": "diary.tomoriserpent.c",
      "label": "日记其三",
      "description": "敌军再度压境，阵线岌岌可危。我沉下心神，令我的意志凌驾一切微小的意志，令我不容忤逆。全军士兵绷直身躯，整齐肃立。一旁从未受过训练的少女似乎也清晰感知到这可怖力量。她的眼底也漫上真切的惶恐与肃穆。无需任何人教导，她下意识挺直脊背，抬手低头，郑重地行了一个标准的军礼。战火肃杀，她是整片战场里最意外的臣服者。这令人痛心。",
      "aspects": {
          "diary.tomoriserpent": 1
      },
      "icon": "concursumdiaries"
    }
  ]
}