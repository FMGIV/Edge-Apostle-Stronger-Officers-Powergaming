	"id": "attackenemy.umiri_withanno.hint.rome",
	"$extends": ["attackenemy.umiri_withanno.hint"],
	"label": "Raid the Enemy Commander?",
	"startdescription": "We have already alerted the enemy. She will not show herself so easily now. She is heavily guarded, beyond our reach. Perhaps in the future, at the end of the liberation of Italy, we can join forces with the New Army and slay this terrible rival...\n\n[You may now force this commander to withdraw in Rome.]",
	"extantreqs": {
		"tool.shape": 1
	}
    }
