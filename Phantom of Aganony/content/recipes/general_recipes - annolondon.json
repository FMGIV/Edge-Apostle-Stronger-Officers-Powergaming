    {
      "id": "annolondon.fighting.attack.needsedgeheart",
      "$extends": ["annolondon.fighting.attack.friend.immortal"],
      "label": "Hoarse Heartbeat",
      "startdescription": "The heart that can still beat throbs violently in my shattered chest, waves of impact spreading through my body. I clench my fists, bones exposed, and with a low roar beat at the wind blades, using the worst possible noise to make her performance difficult to continue.",
      "requirements": {
        "needsedgeheart": 1,
        "edge": "needsedgeheart",
        "heart": "needsedgeheart"
      },
      "aspects": {
	      "fatiguing": 1,
        "killmortal": 1
      }
    },
