      "id": "annolondon.fighting.attack.needsedgegrail",
      "$extends": ["annolondon.fighting.attack.friend.immortal"],
      "label": "Truth of Blood",
      "startdescription": "The Wolf does not hold authority over blood, but the Wolf has an eternal thirst for fresh blood. Therefore, the Wolf despises all pretentious false flesh and blood. I cut my palm viciously and flick it; the flying droplets of blood erode the illusory stains.",
      "requirements": {
        "needsedgegrail": 1,
        "edge": "needsedgegrail",
        "grail": "needsedgegrail"
      },
