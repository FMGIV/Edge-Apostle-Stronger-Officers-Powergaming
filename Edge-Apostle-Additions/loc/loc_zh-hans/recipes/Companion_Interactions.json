	"id": "hint.companion.konstantin",
	"actionid": "communicate",
	"$priority" : 1,
	"label": "去咨询康斯坦丁吗？",
	"startdescription": "当我走进医生的帐篷时，鼻孔立刻被那种总是伴随着他工作的血腥味刺得生疼。医生注意到我后，从帐篷另一端盯着我。\n\n‘如果还需我的经验，就快点。今天我还有许多截肢手术要处理。'",
	"requirements": {
	    "friend.konstantin": 1
	},
	"hintonly": true,
	"craftable": false
    },
	
