	"requirements": {
	    "friend.nikolai": 1
	},
	"hintonly": true,
	"craftable": false
    },
	
	{
	"id": "hint.companion.fiorenza",
	"actionid": "communicate",
	"$priority" : 1,
	"label": "与菲奥伦扎商讨？",
    "startdescription": "我必须把那帮追求菲奥伦扎的臭小子拉开才能有机会和她说话。摆脱了那帮家伙之后，她明显松了口气。\n\n“<i>谢啦！</i>……呃我真的很高兴大家这么喜欢我，但总得让我休息会儿……那个，是需要我干什么吗？”",
	"requirements": {
	    "friend.fiorenza": 1
	},
	"hintonly": true,
	"craftable": false
