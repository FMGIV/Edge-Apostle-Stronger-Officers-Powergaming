    {
      "id": "sergei.seventeen",
      "label": "Fear of the Iron-Eater",
      "description": "What did he see? What is he afraid of? Can one who creates fear also have something to fear?",
      "aspects": {
        "op": 1,
        "long.blocker": 1
      }
    },
    {
      "id": "wilhelm.seventeen",
      "label": "Raging Flame Burns Winter",
      "description": "The surging heat once melted ice and snow; the blazing flames once tore through the cold wind. That raging flame declared to the world: winter is merely fuel for the flames of war.",
      "aspects": {
        "op": 1,
        "long.blocker": 1
      }
    },
    {
