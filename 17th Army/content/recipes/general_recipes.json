    {
      "id": "dream.seventeen.end",
      "label": "Dream of snow and wind",
      "startdescription": "I walk alone through a blizzard; piano music sounds in the distance. The melody seeps through my skin, invades my veins, and freezes my blood and heartbeat together. I feel my consciousness dragged downward by an icy hand...\n\nThen I see a frost-covered window, and outside it a dark figure. The figure writes five Roman numerals on the pane with withered fingers:\n\n<b><i>“IV VII X XIV XVII”</i></b>",
      "description": "When I wake, my face is grim – those same numbers appear on the window before me.",
      "maxexecutions": 1,
      "burnimage": "dreamaboutseventeen",
      "effects": {
        "mem.fear": 1
      },
      "warmup": 30
    },
